<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin - Ms Trader</title><style>body{font-family:Arial;background:#f5f5f5;margin:0;padding:10px}h2{text-align:center}.box{background:#fff;padding:15px;border-radius:12px;margin:10px 0}input{width:100%;padding:11px;margin:6px 0;border:1px solid #ddd;border-radius:8px}button{width:100%;background:#000;color:#fff;border:0;padding:11px;border-radius:20px;margin:5px 0}.ord{background:#fffbe6;border:1px solid #ffcc00;padding:10px;margin:5px 0;border-radius:10px;font-size:13px}.card{background:#fff;padding:10px;border-radius:10px;margin:5px 0;text-align:center}.card img{width:100%;height:120px;object-fit:cover;border-radius:8px}</style></head><body>
<h2>Ms Trader - ADMIN</h2>
<div class="box" id="loginBox"><h3>Admin Login</h3><input id="u" placeholder="admin"><input id="p" type="password" placeholder="1234"><button style="background:#ff1744" onclick="if(document.getElementById('u').value=='admin'&&document.getElementById('p').value=='1234'){document.getElementById('loginBox').style.display='none';document.getElementById('panel').style.display='block';showOrders();showP()}else{alert('Galat Password - 1234 likho')}">Login</button></div>
<div id="panel" style="display:none">
<div class="box"><b>📦 NAYE ORDERS:</b><div id="ordersList">Koi Order Nahi</div><button style="background:red" onclick="localStorage.removeItem('ORDERS');showOrders()">Orders Clear Karo</button></div>
<div class="box"><b>➕ Product Add:</b><input type="file" accept="image/*,video/*" id="f"><input id="n" placeholder="Product Naam"><input id="pr" placeholder="Price"><button style="background:green" onclick="addP()">+ Add Product</button><div id="msg"></div></div>
<div class="box"><b>🗑️ Products:</b><div id="plist"></div></div>
<div class="box"><b>🔗 Social Links:</b><input id="inFB" placeholder="Facebook Link"><input id="inTK" placeholder="TikTok Link"><input id="inIG" placeholder="Instagram Link"><button style="background:#1877F2" onclick="localStorage.setItem('LINKS',JSON.stringify({fb:document.getElementById('inFB').value,tk:document.getElementById('inTK').value,ig:document.getElementById('inIG').value}));alert('Save Ho Gaya')">💾 Save Links</button></div>
<a href="index.html"><button>👀 Customer Site Dekho</button></a></div>
<script>
let P=JSON.parse(localStorage.getItem('P3')||'[]');let fd='';
document.getElementById('f').addEventListener('change',e=>{let r=new FileReader();r.onload=()=>{fd=r.result};r.readAsDataURL(e.target.files[0])});
function showOrders(){let O=JSON.parse(localStorage.getItem('ORDERS')||'[]');document.getElementById('ordersList').innerHTML=O.length?O.map(o=>'<div class="ord">📦 '+o.n+' - AED '+o.p+'<br>'+o.pay+' - '+o.cust+' - '+o.phone+'<br>'+o.time+'</div>').join(''):'Koi Order Nahi'}
function showP(){document.getElementById('plist').innerHTML=P.map((x,i)=>'<div class="card"><img src="'+x.i+'"><b>'+x.n+' - AED '+x.p+'</b><button style="background:red" onclick="P.splice('+i+',1);localStorage.setItem(\'P3\',JSON.stringify(P));showP()">Delete</button></div>').join('')}
function addP(){let n=document.getElementById('n').value,pr=document.getElementById('pr').value;if(!n||!pr||!fd){alert('Photo chuno');return}P.push({n:n,p:pr,i:fd,t:fd.includes('video')?'vid':'img'});localStorage.setItem('P3',JSON.stringify(P));fd='';document.getElementById('msg').innerHTML='✅ Add Ho Gaya!';showP()}
showOrders();
</script></body></html>
