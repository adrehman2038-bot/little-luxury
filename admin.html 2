</div>
<div class="box" id="b2" style="display:none">
<h3>Admin Panel ✅</h3>
<a class="btn" href="https://docs.google.com/forms/u/0/" target="_blank">Orders Dekhen</a>
<a class="btn" href="https://an2038-bot.github.io/">Website Dekhen</a>
</div>
<script>
function login(){
if(document.getElementById('p').value=="admin123"){
document.getElementById('b1').style.display='none';
document.getElementById('b2').style.display='block';
}else{alert("Ghalat Password");}
}
</script>
</body>
</html>
